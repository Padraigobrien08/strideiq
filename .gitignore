# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root and nested workspaces)
node_modules/
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Playwright viewport suite (e2e/): saved demo state, run output and the HTML report
/e2e/.state/
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build
packages/**/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep .env.example in repo
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python backend (backend/)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Strava exports (PII — never commit)
export_*/
**/export_*/

# Local scratch / backlog notes
FUTURE_IDEAS.md

# Impeccable design-tool artifacts
.impeccable/

# Audit workspace — assessment artifacts, deliberately not part of the repo
.eval/
