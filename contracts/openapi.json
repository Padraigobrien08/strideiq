{
  "openapi": "3.1.0",
  "info": {
    "title": "StrideIQ backend",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error",
            "description": "Human-readable message, safe to show to the athlete."
          },
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Stable machine-readable code, e.g. `not_found`."
          },
          "correlation_id": {
            "type": "string",
            "title": "Correlation Id",
            "description": "Request correlation ID, also in `x-request-id`."
          }
        },
        "type": "object",
        "required": [
          "error",
          "code",
          "correlation_id"
        ],
        "title": "ErrorResponse",
        "description": "The error envelope for every non-2xx response.\n\n`error` keeps the shape the UI already reads from Next routes (`{ error }`), so\nthe BFF can pass a backend error through unchanged."
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "api_version": {
            "type": "string",
            "title": "Api Version",
            "description": "Path version this service serves, e.g. `v1`."
          },
          "environment": {
            "type": "string",
            "enum": [
              "local",
              "test",
              "preview",
              "production"
            ],
            "title": "Environment"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "api_version",
          "environment"
        ],
        "title": "HealthResponse",
        "description": "Liveness: the process is up and serving requests."
      },
      "ReadinessCheck": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "name",
          "ok"
        ],
        "title": "ReadinessCheck"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ReadinessCheck"
            },
            "type": "array",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse",
        "description": "Readiness: every dependency needed to serve traffic is available."
      }
    }
  }
}
