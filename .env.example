# =============================================================================
# StrideIQ — copy to .env.local (never commit .env.local)
# =============================================================================
#
# NONE OF THIS IS REQUIRED TO TRY THE APP. "Try the demo" (sample athlete) and
# local Strava-export import both run 100% in the browser — no vars, no DB, no
# API key. Only set the variables below for live Strava sync, Coach, or MCP.
#
# MINIMUM FOR LOCAL DEV (export CSV only):
#   Leave this file empty or unset — no server vars required.
#
# MINIMUM FOR STRAVA OAUTH + COACH:
#   DATABASE_URL, SESSION_SECRET, STRAVA_CLIENT_ID, STRAVA_CLIENT_SECRET,
#   STRAVA_REDIRECT_URI, OPENAI_API_KEY (or ANTHROPIC_API_KEY)
#
# See docs/DEPLOYMENT.md for production (Vercel + Neon + Strava callback URLs).
# =============================================================================

# --- Strava OAuth (https://www.strava.com/settings/api) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Leave STRAVA_REDIRECT_URI BLANK to let the callback follow whatever host you
# browse (localhost, a LAN IP via `npm run dev:lan`, or a tunnel) — just set
# your Strava app's "Authorization Callback Domain" to that host. Only set this
# to pin a fixed callback (e.g. a production domain). See "View on your phone"
# in the README.
STRAVA_REDIRECT_URI=

# --- Strava webhooks (optional auto-sync) ---
# Random string; must match Strava subscription verify token
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Public HTTPS URL ending with /api/webhooks/strava
# Local dev: ngrok http 3000 → https://xxxx.ngrok-free.app/api/webhooks/strava
STRAVA_WEBHOOK_CALLBACK_URL=
# Webhook signing secret from https://www.strava.com/settings/api — NOT the client
# secret. Strava signs each event POST with it (X-Strava-Signature: t=…,v1=…).
# Required: event deliveries are rejected with 403 while this is unset, since the
# delete branch of the handler removes activities and unsigned input can't be trusted.
STRAVA_WEBHOOK_SIGNING_SECRET=

# --- Database (Postgres — required for OAuth / Coach / sync) ---
# Default = local Postgres from `docker compose up -d` (see README Path B).
# For hosted Neon, replace with its pooled connection string
# (https://console.neon.tech). The driver is auto-selected from the host.
DATABASE_URL=postgresql://strideiq:strideiq@localhost:5432/strideiq

# --- Session (required when DATABASE_URL is set) ---
# Generate: openssl rand -hex 32
SESSION_SECRET=

# --- Database tests (opt-in; NOT needed to run the app) ---
# lib/db/__tests__ round-trip against real Postgres and DELETE rows, so they skip
# unless this is set. Intentionally separate from DATABASE_URL so a production
# connection string can never switch them on. A non-local host fails loudly.
# TEST_DATABASE_URL=postgresql://strideiq:strideiq@localhost:5432/strideiq

# --- LLM — Coach chat + AI weekly plan (at least one provider for Coach) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WEEKLY_PLAN_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- MCP / automation (optional — maps API key to Neon user id) ---
STRIDEIQ_API_KEY=
STRIDEIQ_API_KEY_USER_ID=

# --- Python backend (optional — Milestone A: health probe only, no user feature) ---
# Server-only origin of the FastAPI service the Next BFF calls (never NEXT_PUBLIC_).
# Leave unset to keep it off. Use 127.0.0.1, not localhost: Node may resolve localhost
# to ::1 while uvicorn listens on IPv4. Only loopback hosts are accepted until
# service-to-service auth lands (docs/adr/0001-service-to-service-auth.md).
# Start it with `npm run backend:dev`, then visit /api/backend/health.
# STRIDEIQ_BACKEND_URL=http://127.0.0.1:8000

# --- Optional ---
# NEON_PROJECT_ID=
# Expose /dev/forecast-lab in production (default: dev only)
# NEXT_PUBLIC_FORECAST_LAB=1
